{
  "slug": "slider",
  "name": "滑块",
  "category": "forms",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/slider)",
  "material": {
    "default": "Regular",
    "rules": [
      "轨道 4px；圆形 thumb 20px；支持键盘左右；标记值用 aria-valuetext"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-slider"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-slider",
    ".gary-slider__track",
    ".gary-slider__range",
    ".gary-slider__thumb"
  ]
}