{
  "slug": "chip",
  "name": "标签胶囊",
  "category": "status-and-filter",
  "source": "adapters/react-shadcn/src/components/ui/chip.tsx",
  "material": {
    "default": "SolidPlate",
    "rules": [
      "用于短标签、筛选或状态",
      "语义色只作用于文字与边框，不给玻璃染色",
      "soft 变体用半透明底；solid 变体用实底"
    ]
  },
  "variants": [
    {
      "name": "soft",
      "selector": ".gary-chip--soft",
      "background": "color-mix(in srgb, var(--gary-text-secondary) 12%, transparent)"
    },
    {
      "name": "solid",
      "selector": ".gary-chip--solid",
      "background": "var(--gary-solid-plate)"
    }
  ],
  "tones": [
    {
      "name": "neutral",
      "selector": ".gary-chip--neutral",
      "color": "var(--gary-text-secondary)"
    },
    {
      "name": "success",
      "selector": ".gary-chip--success, .gary-chip[data-tone='positive']",
      "color": "var(--gary-state-positive)"
    },
    {
      "name": "warning",
      "selector": ".gary-chip--warning, .gary-chip[data-tone='caution']",
      "color": "var(--gary-state-caution)"
    },
    {
      "name": "critical",
      "selector": ".gary-chip--critical, .gary-chip[data-tone='critical']",
      "color": "var(--gary-state-critical)"
    }
  ],
  "sizes": [
    {"name": "sm", "height": "24px", "fontSize": "11px", "paddingX": "8px"},
    {"name": "default", "height": "28px", "fontSize": "12px", "paddingX": "10px"}
  ],
  "states": [
    {
      "name": "selected",
      "selector": ".gary-chip:is([aria-pressed='true'], [aria-selected='true']), .gary-chip[aria-checked='true']"
    },
    {
      "name": "focus-visible",
      "selector": ".gary-chip:focus-visible"
    },
    {
      "name": "disabled",
      "selector": ".gary-chip:is(:disabled, [aria-disabled='true'])"
    }
  ],
  "accessibility": {
    "role": "status text or native button",
    "requirements": [
      "静态标签不得伪装成按钮",
      "可选择 chip 使用 button 并同步 aria-pressed",
      "状态不能只靠颜色表达"
    ]
  },
  "cssClasses": [
    ".gary-chip",
    ".gary-chip--soft",
    ".gary-chip--solid",
    ".gary-chip--neutral",
    ".gary-chip--success",
    ".gary-chip--warning",
    ".gary-chip--critical"
  ]
}
