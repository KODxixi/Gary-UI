{
  "slug": "chip",
  "name": "标签胶囊",
  "category": "status-and-filter",
  "material": {
    "default": "SolidPlate",
    "rules": [
      "用于短标签、筛选或状态",
      "语义色只作用于文字，不给玻璃染色"
    ]
  },
  "variants": [
    {
      "name": "neutral",
      "selector": ".gary-chip"
    },
    {
      "name": "positive|caution|critical",
      "selector": "[data-tone]"
    },
    {
      "name": "selectable",
      "selector": "button.gary-chip"
    }
  ],
  "states": [
    {
      "name": "selected",
      "selector": "[aria-pressed=\"true\"], [aria-selected=\"true\"]"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled=\"true\"]"
    }
  ],
  "accessibility": {
    "role": "status text or native button",
    "requirements": [
      "静态标签不得伪装成按钮",
      "可选择 chip 使用 button 并同步 aria-pressed",
      "状态不能只靠颜色表达"
    ]
  },
  "cssClasses": [
    ".gary-chip"
  ]
}
