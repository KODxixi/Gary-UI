{
  "slug": "dropdown-menu",
  "name": "下拉菜单",
  "category": "overlay",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/dropdown-menu)",
  "material": {
    "default": "Regular",
    "rules": [
      "触发按钮与浮层分离；浮层用 Regular 玻璃；菜单项高 36px；快捷键右对齐等宽"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-dropdown-menu"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-dropdown-menu",
    ".gary-dropdown-menu__trigger",
    ".gary-dropdown-menu__content",
    ".gary-dropdown-menu__item",
    ".gary-dropdown-menu__separator",
    ".gary-dropdown-menu__shortcut",
    ".gary-dropdown-menu__sub-trigger",
    ".gary-dropdown-menu__checkbox-item",
    ".gary-dropdown-menu__radio-item"
  ]
}