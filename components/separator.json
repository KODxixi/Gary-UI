{
  "slug": "separator",
  "name": "分隔线",
  "category": "layout",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/separator)",
  "material": {
    "default": "Regular",
    "rules": [
      "1px 线；用 border-shadow 色；带文字时用虚线分隔"
    ]
  },
  "variants": [
    {
      "name": "horizontal",
      "selector": ".gary-separator--horizontal"
    },
    {
      "name": "vertical",
      "selector": ".gary-separator--vertical"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-separator"
  ]
}