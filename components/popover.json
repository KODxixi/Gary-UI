{
  "slug": "popover",
  "name": "弹出层",
  "category": "overlay",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/popover)",
  "material": {
    "default": "Regular",
    "rules": [
      "Regular 玻璃浮层；与 trigger 对齐；箭头可选；不遮挡焦点"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-popover"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-popover",
    ".gary-popover__trigger",
    ".gary-popover__content",
    ".gary-popover__close"
  ]
}