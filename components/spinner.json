{
  "slug": "spinner",
  "name": "加载圈",
  "category": "feedback",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/spinner)",
  "material": {
    "default": "Regular",
    "rules": [
      "16px 圆形描边旋转动画；关键位用 focus-ring 色"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-spinner"
    },
    {
      "name": "small",
      "selector": ".gary-spinner--sm"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-spinner"
  ]
}