{
  "slug": "switch",
  "name": "开关",
  "category": "forms",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/switch)",
  "material": {
    "default": "Regular",
    "rules": [
      "44×24px 轨道；20px 圆形 thumb；选中态用 state-positive"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-switch"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-switch",
    ".gary-switch__thumb"
  ]
}