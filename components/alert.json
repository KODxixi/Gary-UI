{
  "slug": "alert",
  "name": "提示框",
  "category": "feedback",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/alert)",
  "material": {
    "default": "Regular",
    "rules": [
      "图标居左，文字居右；语义色只用于图标与左边框"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-alert"
    },
    {
      "name": "success",
      "selector": ".gary-alert--success"
    },
    {
      "name": "warning",
      "selector": ".gary-alert--warning"
    },
    {
      "name": "critical",
      "selector": ".gary-alert--critical"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-alert",
    ".gary-alert__icon",
    ".gary-alert__title",
    ".gary-alert__description"
  ]
}