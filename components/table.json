    {"name": "body", "selector": "[data-slot='table-body']", "role": "数据行分组，最后一行无边框"},
    {"name": "footer", "selector": "[data-slot='table-footer']", "role": "表尾汇总行，bg-muted/50 实底"},
    {"name": "row", "selector": "[data-slot='table-row']", "role": "表格行，hover:bg-muted/50，selected 状态 bg-muted"},
    {"name": "head", "selector": "[data-slot='table-head']", "role": "表头单元格，h-10 px-2，font-medium text-muted-foreground"},
    {"name": "cell", "selector": "[data-slot='table-cell']", "role": "数据单元格，p-2 align-middle"},
    {"name": "caption", "selector": "[data-slot='table-caption']", "role": "表题，mt-4 text-sm text-muted-foreground"}
