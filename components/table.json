  "interaction": {
    "pressResponseMs": {"min": 100, "max": 160},
    "frequentUiMaxMs": 300,
    "interruptible": true,
    "reducedMotion": "保留行 hover 颜色反馈，移除 transition 位移"
  },
  "accessibility": {
    "role": "native table with th in thead",
    "requirements": [
      "表头单元格置于 thead/th，数据单元格置于 tbody/td",
