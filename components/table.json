      "最后一行不显示底边框，表尾使用 bg-muted/50 实底条"
    ]
  },
  "variants": [],
  "slots": [
    {"name": "table", "selector": "[data-slot='table']", "role": "数据表格本体，w-full caption-bottom text-sm"},
