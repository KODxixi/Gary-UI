{
  "slug": "radio-group",
  "name": "单选组",
  "category": "forms",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/radio-group)",
  "material": {
    "default": "Regular",
    "rules": [
      "20px 圆形控件；选中态内填充 primary；组内同名"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-radio-group"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-radio-group",
    ".gary-radio-group__item",
    ".gary-radio-group__indicator"
  ]
}