{
  "slug": "kbd",
  "name": "键盘按键",
  "category": "layout",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/kbd)",
  "material": {
    "default": "Regular",
    "rules": [
      "实底小胶囊；等宽字体；与 menu shortcut 样式一致"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-kbd"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-kbd"
  ]
}