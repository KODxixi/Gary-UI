{
  "slug": "accordion",
  "name": "折叠面板",
  "category": "overlay",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/accordion)",
  "material": {
    "default": "Regular",
    "rules": [
      "条目间用 separator 分隔；展开内容用 SolidPlate 承载"
    ]
  },
  "variants": [
    {
      "name": "item",
      "selector": ".gary-accordion-item"
    },
    {
      "name": "trigger",
      "selector": ".gary-accordion-trigger"
    },
    {
      "name": "content",
      "selector": ".gary-accordion-content"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-accordion",
    ".gary-accordion-item",
    ".gary-accordion-trigger",
    ".gary-accordion-content"
  ]
}