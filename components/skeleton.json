{
  "slug": "skeleton",
  "name": "骨架屏",
  "category": "feedback",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/skeleton)",
  "material": {
    "default": "Regular",
    "rules": [
      "灰色脉动块；用 surface-sunken 色；动画 1.5s 循环"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-skeleton"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-skeleton"
  ]
}