{
  "slug": "sonner",
  "name": "Toast 通知",
  "category": "feedback",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/sonner)",
  "material": {
    "default": "Regular",
    "rules": [
      "右下角堆叠；Thick 玻璃；自动消失 4s；支持手势关闭"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-sonner"
    },
    {
      "name": "success",
      "selector": ".gary-sonner--success"
    },
    {
      "name": "warning",
      "selector": ".gary-sonner--warning"
    },
    {
      "name": "critical",
      "selector": ".gary-sonner--critical"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-sonner",
    ".gary-sonner__toast",
    ".gary-sonner__title",
    ".gary-sonner__description",
    ".gary-sonner__action",
    ".gary-sonner__close"
  ]
}