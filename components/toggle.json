{
  "slug": "toggle",
  "name": "开关按钮",
  "category": "actions",
  "source": "shadcn/ui (https://ui.shadcn.com/docs/components/toggle)",
  "material": {
    "default": "Regular",
    "rules": [
      "按钮形态的二态开关；选中态用实底；aria-pressed"
    ]
  },
  "variants": [
    {
      "name": "default",
      "selector": ".gary-toggle"
    },
    {
      "name": "outline",
      "selector": ".gary-toggle--outline"
    }
  ],
  "states": [
    {
      "name": "hover",
      "selector": ":hover"
    },
    {
      "name": "focus-visible",
      "selector": ":focus-visible"
    },
    {
      "name": "disabled",
      "selector": ":disabled, [aria-disabled='true']"
    }
  ],
  "accessibility": {
    "role": "按组件语义使用对应 ARIA role",
    "requirements": [
      "所有交互元素可键盘操作",
      "状态变化同步 aria 属性",
      "不只靠颜色传达信息",
      "文字放大后不裁切"
    ]
  },
  "cssClasses": [
    ".gary-toggle",
    ".gary-toggle__icon"
  ]
}