{
  "schemaVersion": 3,
  "library": "gary-ui",
  "canonical": true,
  "readOrder": ["SKILL.md", "spec/system.json", "contracts/invocation.schema.json", "README.md"],
  "routes": {
    "visual": {
      "when": "visual command or visual route",
      "read": ["spec/scene-recipes.json", "contracts/visual-manifest.schema.json", "adapters/visual/capabilities.json", "adapters/visual/README.md"]
    },
    "chart": {
      "when": "chart expression or quantitative visual",
      "read": ["docs/CHART_EXPRESSION.md", "docs/CHART_COLOR.md", "spec/chart-recipes.json"]
    },
    "session": {
      "when": "user explicitly requests monitored co-design",
      "read": ["contracts/task.schema.json", "contracts/session.schema.json", "contracts/proposal.schema.json", "contracts/feedback.schema.json", "contracts/approval.schema.json", "contracts/evidence.schema.json", "docs/GARY_UI_AGENT_COLLABORATION_WHITEPAPER.md"],
      "activation": "optional-escalation",
      "defaultFor": [],
      "requiresUserConsent": true
    },
    "react": {
      "when": "React adapter is requested",
      "read": ["adapters/react-shadcn/README.md", "adapters/react-shadcn/registry.json"]
    },
    "component": {
      "when": "a component is requested",
      "read": ["components/index.json", "components/<slug>.json"]
    },
    "runtime": {
      "when": "consumer runtime projection is requested",
      "read": ["runtime/manifest.json"]
    }
  },
  "session": {
    "activation": "optional-escalation",
    "defaultFor": [],
    "requiresUserConsent": true
  },
  "entrypoints": {
    "system": "spec/system.json",
    "css": "tokens/base.css",
    "invocation": "contracts/invocation.schema.json",
    "task": "contracts/task.schema.json",
    "portal": "portal/index.html",
    "sessionUI": "session/index.html",
    "patterns": "patterns/starting-points/index.html",
    "visualAdapter": "adapters/visual/README.md",
    "visualManifest": "contracts/visual-manifest.schema.json",
    "componentIndex": "components/index.json"
  },
  "surfaces": {"session": "--surface session", "portal": "--surface portal", "combined": false},
  "protectedResources": {
    "artifactUrlContainsToken": false,
    "evidenceUrlContainsToken": false,
    "authentication": "path-scoped HttpOnly SameSite=Strict cookie"
  },
  "runtimeProjection": "runtime/manifest.json",
  "runtimePolicy": {
    "canonicalOnlyWritable": true,
    "consumerRuntimeReadOnly": true,
    "syncReceiptPersistence": "none"
  },
  "notRuntimeAuthority": ["portal/", "decisions/", "provenance/", "scripts/tests/"],
  "neverAuthoritative": ["screenshots", "runtime copies", "legacy Apple-UI skill"]
}
