        "eyebrow": "Gary-UI 重建 · R5",
        "badge": "图表与图示",
        "title": "图表：把真实经营数据放回报告页",
        "sub": "六类图表全部由同一套 theme token 渲染，原生 SVG、零脚本、零图表库、零字面色值。"
      }
