node_modules/
dist/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

_site/
public-build/

# Distributed adapter entrypoints must remain available in a fresh clone.
!adapters/react-shadcn/dist/
!adapters/react-shadcn/dist/**

# Runtime artifact protection — regenerated locally, never tracked
.last-good/
.failed/
.candidates/

# Visual adapter build artifacts — regenerate with npm install && npm run build
adapters/visual/runtime/runner.cjs
adapters/visual/runtime/build-meta.json
adapters/visual/browsers.json
# npm dependencies — installed on demand, never vendored in git
adapters/visual/vendor/node/

# Generated visual outputs — regenerated by visual adapter, never source
examples/**/outputs/
!examples/visuals/outputs/
!examples/visuals/outputs/**
!examples/demos/visuals/outputs/
!examples/demos/visuals/outputs/**
# Acceptance screenshots — recorded in docs text, images regenerated on demand
examples/**/evidence/**/*.png
!examples/demos/evidence/edition-02/
!examples/demos/evidence/edition-02/*-dark.png
examples/**/evidence/**/*.webm
# Portal evidence screenshots — design QA artifacts, regenerated on demand
portal/evidence/**/*.png
portal/evidence/**/*.jpg
# Visual-check generated screenshots — regenerated by archify visual-check
**/*.visual-check.*.png
# Generated output directories (singular form used by some visual recipes)
examples/visuals/**/output/
