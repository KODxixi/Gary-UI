{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gary-ui:contracts:command-result:v1",
  "title": "Gary-UI Command Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "status",
    "state",
    "sessionId",
    "version",
    "outputs",
    "issues",
    "warnings",
    "evidence",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "needs-human", "drift"]
    },
    "state": {
      "type": ["string", "null"]
    },
    "sessionId": {
      "type": ["string", "null"]
    },
    "version": {
      "type": "string",
      "const": "2.0.0"
    },
    "outputs": {
      "type": "object"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
