{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gary-ui:contracts:approval:v1",
  "title": "Gary-UI Co-design Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "sessionId",
    "proposalId",
    "revision",
    "feedbackId",
    "selectedOptionId",
    "decisionHash",
    "createdAt",
    "finalizedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "approvalId": {
      "type": "string",
      "pattern": "^apr_[a-f0-9]{24}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "proposalId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "feedbackId": {
      "type": "string",
      "pattern": "^fb_[a-f0-9]{24}$"
    },
    "selectedOptionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "decisionHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "finalizedAt": {
      "type": ["string", "null"],
      "maxLength": 40
    }
  }
}
