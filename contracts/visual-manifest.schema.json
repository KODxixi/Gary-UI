{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gary-ui:contracts:visual-manifest:v1",
  "title": "Gary-UI Visual Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "outputRoot", "visuals"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "project": {"type": "string", "minLength": 1, "maxLength": 160},
    "outputRoot": {"type": "string", "minLength": 1, "maxLength": 1024},
    "visuals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "tool", "source", "scene", "theme", "formats", "citation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "title": {"type": "string", "maxLength": 240},
          "description": {"type": "string", "maxLength": 1000},
          "purpose": {"enum": ["architecture", "workflow", "sequence", "data-flow", "lifecycle", "quantitative", "outline", "infographic", "simple-flow", "icons"]},
          "tool": {"enum": ["archify", "echarts", "markmap", "antv-infographic", "mermaid", "lucide"]},
          "source": {"type": "string", "minLength": 1, "maxLength": 1024},
          "scene": {"enum": ["reading", "analysis", "showcase"]},
          "theme": {"enum": ["dark", "light"]},
          "quality": {"enum": ["standard", "showcase"]},
          "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["html", "svg", "png", "pdf"]}},
          "citation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url", "note"],
            "properties": {
              "label": {"type": "string", "minLength": 1, "maxLength": 240},
              "url": {"type": ["string", "null"], "maxLength": 2048},
              "note": {"type": "string", "maxLength": 1000}
            }
          }
        }
      }
    }
  }
}
