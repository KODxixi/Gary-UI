{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gary-ui:contracts:proposal:v1",
  "title": "Gary-UI Co-design Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "proposalId",
    "revision",
    "baseRevision",
    "mode",
    "understanding",
    "assumptions",
    "recommendation",
    "options",
    "openDecisions",
    "changeSet"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "proposalId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "type": "string",
      "enum": ["quick", "compare", "deep-review"]
    },
    "understanding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "assumptions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "reason"],
      "properties": {
        "optionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "optionId",
          "label",
          "kind",
          "rationale",
          "risks",
          "expectedBenefit",
          "visualRoute",
          "artifactPath"
        ],
        "properties": {
          "optionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": ["recommended", "alternative", "stretch"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "risks": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "expectedBenefit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "visualRoute": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "skill",
              "application",
              "page",
              "theme",
              "material",
              "density"
            ],
            "properties": {
              "schemaVersion": {
                "type": "integer",
                "const": 1
              },
              "skill": {
                "type": "string",
                "const": "gary-liquidglass-ui"
              },
              "application": {
                "type": "string",
                "enum": ["board", "scroll-report", "web-ui"]
              },
              "page": {
                "type": "string",
                "enum": ["report-cover", "image-page", "data-page", "manual-toc"]
              },
              "theme": {
                "type": "string",
                "enum": ["dark", "light"]
              },
              "material": {
                "type": "string",
                "enum": ["ultrathin", "regular", "thick", "solid-plate"]
              },
              "density": {
                "type": "string",
                "enum": ["spacious", "balanced", "compact"]
              }
            }
          },
          "artifactPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "lockedDecisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "openDecisions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "options"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "changeSet": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
