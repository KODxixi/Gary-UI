{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gary-ui:contracts:evidence:v1",
  "title": "Gary-UI Session Verification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "proposalId",
    "revision",
    "approvalId",
    "result",
    "summary",
    "checks",
    "acceptanceCoverage",
    "artifacts",
    "skillsUsed"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "proposalId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approvalId": {
      "type": "string",
      "pattern": "^apr_[a-f0-9]{24}$"
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "acceptanceCoverage": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirementId", "checkId", "artifactLabels"],
        "properties": {
          "requirementId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{0,159}$"
          },
          "checkId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "artifactLabels": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      }
    },    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label", "sourcePath"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "screenshot",
              "browser-report",
              "build-report",
              "console-log",
              "accessibility-report",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "viewport": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "skillsUsed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  }
}
